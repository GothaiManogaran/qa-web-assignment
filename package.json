{
  "name": "testautomation-web",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test --grep-invert \"@a11y|@known-issue\"",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:sanity": "playwright test --grep @sanity",
    "test:e2e:a11y": "playwright test login-accessibility"
  },
  "dependencies": {
    "vue": "^3.3.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@vitejs/plugin-vue": "^4.3.4",
    "vite": "^4.4.9",
    "vitest": "^0.34.6"
  }
}
